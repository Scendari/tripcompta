<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Droits de Trip Compta signée « Developer ID » avec le « runtime renforcé » (obligatoire pour la notarisation).
     Python (PyInstaller) a besoin de ces deux exceptions : mémoire exécutable non signée (ctypes, libffi) et
     bibliothèques chargées depuis l'application elle-même. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
